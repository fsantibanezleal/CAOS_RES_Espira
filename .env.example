# Espira environment example. Copy to .env (git-ignored) only when needed. NO secrets here.
# The static product needs none of this: the app/ backend is dormant. These variables matter only if
# app/ is activated (an ADR-0002 trigger).
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
# CORS origins for the SPA (comma-separated)
DEV_ORIGINS=http://localhost:5173
PROD_ORIGINS=
# where the built SPA and the committed artifacts live (relative to the repo root)
FRONTEND_DIST=frontend/dist
DATA_DIR=data/artifacts
# The long lattice bake checkpoints here; keep heavy temporary files off the system drive.
ESPIRA_CHECKPOINT_DIR=
